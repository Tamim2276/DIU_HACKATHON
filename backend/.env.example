# Copy this file to .env for local use. The .env file is never committed.

# Addresses of the web app that may call this API, separated by commas.
ALLOWED_ORIGINS=http://localhost:5173

# Optional. A Google Gemini API key (https://aistudio.google.com/apikey), used to answer follow-up questions.
# Without it the app still works: a question gets the standard explanation.
GEMINI_API_KEY=

# Optional. The Gemini models to try, in order, separated by commas. Left out, the app's own list is used.
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.8-flash
